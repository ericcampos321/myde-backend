{
  "name": "myde-backend",
  "version": "1.0.0",
  "description": "Atendimento WhatsApp com IA — backend (Fastify + BullMQ + Drizzle)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap/server.ts",
    "dev:worker": "tsx watch src/tenant/message-processing/MessageProcessingWorker.ts",
    "build": "tsc",
    "start": "node dist/bootstrap/server.js",
    "start:worker": "node dist/tenant/message-processing/MessageProcessingWorker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seeds/seedDefaultTenant.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.2",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
