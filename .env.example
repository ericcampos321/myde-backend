# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Banco de dados ───────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atendimento

# ─── Fila (Redis + BullMQ) ────────────────────────────────
# Host (Windows/macOS/Linux): Redis exposto na 6380 para evitar conflito com
# outros projetos locais que usem a 6379.
REDIS_URL=redis://localhost:6380
# Dentro da rede Docker, Redis fica em redis://redis:6379

# ─── OpenAI ───────────────────────────────────────────────
# OpenAI real: preencha no .env local. Nunca versione uma chave real.
# Obrigatória para gerar respostas de IA (em NODE_ENV=test usa-se um stub).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Meta WhatsApp Cloud API ──────────────────────────────
# Meta/WhatsApp real: preencha no .env local. Nunca versione tokens reais.
# Obrigatórias para receber/validar webhooks e (futuramente) enviar mensagens.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_TOKEN=
META_PHONE_NUMBER_ID=
META_API_BASE_URL=https://graph.facebook.com/v20.0