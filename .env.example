# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Banco de dados ───────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atendimento

# ─── Fila (Redis + BullMQ) ────────────────────────────────
# Host (Windows/macOS/Linux): Redis exposto na 6380 para evitar conflito com
# outros projetos locais que usem a 6379.
REDIS_URL=redis://localhost:6380
# Dentro da rede Docker, Redis fica em redis://redis:6379

# ─── OpenAI ───────────────────────────────────────────────
# Obrigatória para gerar respostas de IA (em NODE_ENV=test usa-se um stub).
OPENAI_API_KEY=sk-proj
OPENAI_MODEL=gpt-5.4

# ─── Meta WhatsApp Cloud API ──────────────────────────────
# Meta/WhatsApp real: preencha no .env local.
# Obrigatórias para receber/validar webhooks
META_VERIFY_TOKEN=myde-webhook-dev
META_APP_SECRET=
META_TOKEN=
META_PHONE_NUMBER_ID=
META_API_BASE_URL=https://graph.facebook.com/v25.0


# ─── Auto-resposta (worker) ───────────────────────────────
# Quando "true", o worker, após gerar a sugestão de IA, ENVIA a resposta ao
# cliente automaticamente pela Meta. Default seguro: "false" (só o composer
# manual envia). Só a string exata "true" liga.
# >>> No fluxo do DESAFIO TÉCNICO use "true" <<< (resposta automática sem frontend).
WHATSAPP_AUTO_REPLY_ENABLED=true