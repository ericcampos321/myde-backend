# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Banco de dados ───────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atendimento

# ─── Fila (Redis + BullMQ) ────────────────────────────────
# Host (Windows/macOS/Linux): Redis exposto na 6380 para evitar conflito com
# outros projetos que usem a 6379.
REDIS_URL=redis://localhost:6380
# Dentro da rede Docker, Redis fica em redis://redis:6379

# ─── OpenAI (opcional — sem a chave, usa Stub provider) ────
# NUNCA versione uma chave real. Deixe vazio para usar o StubAiProvider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Meta WhatsApp Cloud API ─────────────────────────────
# PADRÃO: valores de mock para desenvolvimento local (docker compose).
# PRODUÇÃO: substitua pelos tokens/segredos reais e aponte para https://graph.facebook.com/v20.0
# NUNCA versione tokens/segredos reais no Git — o .env está em .gitignore.
META_VERIFY_TOKEN=meu-verify-token-secreto
META_APP_SECRET=super-secret-app-secret-trocar
META_TOKEN=mock-token
META_PHONE_NUMBER_ID=123456789012345
META_API_BASE_URL=http://localhost:8001

MOCK_META_URL=http://localhost:8001
