# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Banco de dados ───────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atendimento

# ─── Fila (Redis + BullMQ) ────────────────────────────────
# Host (Windows/macOS/Linux): Redis exposto na 6380 para evitar conflito com
# outros projetos que usem a 6379.
REDIS_URL=redis://localhost:6380
# Dentro da rede Docker, Redis fica em redis://redis:6379

# ─── OpenAI (opcional — sem a chave, usa Stub provider) ────
# NUNCA versione uma chave real. Deixe vazio para usar o StubAiProvider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Meta WhatsApp Cloud API (produção/real) ──────────────
# Preencha apenas no seu .env local. NUNCA versione tokens/segredos reais.
# Token de verificação do handshake do webhook (você define; igual ao painel da Meta).
META_VERIFY_TOKEN=
# App Secret — valida a assinatura X-Hub-Signature-256.
META_APP_SECRET=
# Token de acesso para enviar mensagens (Graph API).
META_TOKEN=
# ID do número de telefone (origem dos envios).
META_PHONE_NUMBER_ID=
# Base da Graph API real.
META_API_BASE_URL=https://graph.facebook.com/v20.0

# ─── Mock local da Meta (desenvolvimento) ─────────────────
# Para testar sem a Meta real, suba o mock (docker compose) e aponte para ele:
#   META_API_BASE_URL=http://localhost:8001
#   META_APP_SECRET=super-secret-app-secret-trocar  (igual ao docker-compose.yml)
#   META_VERIFY_TOKEN=meu-verify-token-secreto
#   META_TOKEN=mock-token
#   META_PHONE_NUMBER_ID=123456789012345
MOCK_META_URL=http://localhost:8001
